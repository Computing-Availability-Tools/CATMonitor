# Runtime-only image for NPU environment.
# Binaries are pre-compiled by build.sh (inside a golang container with
# the host driver mounted), so this Dockerfile just packages them.
FROM alpine:latest

RUN apk add --no-cache ipmitool smartmontools util-linux dmidecode

COPY catmonitor /usr/local/bin/catmonitor
COPY dfee /usr/local/bin/dfee
COPY web /usr/local/bin/web
COPY docker/catmonitor.yaml /etc/catmonitor/catmonitor.yaml
COPY configs/metrics.yaml /etc/catmonitor/metrics.yaml

ENTRYPOINT ["/usr/local/bin/catmonitor", "daemon", "--config", "/etc/catmonitor/catmonitor.yaml"]
