# Copy OUTSIDE Git. These are inputs for the guide/check_site_inputs.py, not
# automatically consumed by docker run or CATMonitor. No credentials here.
SOURCE_DIR=
SOURCE_IDENTITY_FILE=
DOCKER_BIN=/usr/bin/docker
DOCKER_ENDPOINT=unix:///var/run/docker.sock
EXPECTED_DOCKER_ROOT=
EXPECTED_PLATFORM=linux/arm64
DEPLOYMENT_MODE=npu
CONTROL_IMAGE=
CONTROL_IMAGE_ID=
CPU_WORKLOAD_IMAGE=
CPU_WORKLOAD_IMAGE_ID=
NPU_WORKLOAD_IMAGE=
NPU_WORKLOAD_IMAGE_ID=
BUILD_ROOT=
NPU_BASE_IMAGE=
NPU_BUILDER_IMAGE=
NPU_RUNTIME_IMAGE=
GO_BUILDER_IMAGE=golang:1.23-bookworm
CANN_ENV_SCRIPT=
HOST_DRIVER_LIB_DIR=
BUILD_NETWORK=none
CONFIG_DIR=
STATE_DIR=
OUTPUT_DIR=
EVIDENCE_DIR=
# Explicit authorized host node, not runtime logical ID. Single mode uses 0.
NPU_HOST_NODE=
NPU_CHIP_GENERATION=
NPU_THREADS=1
# Approved CPU budgets for CPU mode; must also match HPL.dat P*Q.
STREAM_THREADS=
HPL_PROCESSES=
HPL_THREADS=
HPCG_PROCESSES=
HPCG_THREADS=
