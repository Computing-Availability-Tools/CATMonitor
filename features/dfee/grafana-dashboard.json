    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU 利用率 (堆叠)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 20,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\",job=~\"$job\"}[5m]) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "IDLE利用率",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "sum(rate(node_cpu_seconds_total{mode!=\"idle\",instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "非IDLE利用率",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "sum(rate(node_cpu_seconds_total{mode=~\"user|nice\",instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "用户空间利用率",
          "range": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "rate(node_cpu_seconds_total{mode=\"system\",instance=~\"$instance\",job=~\"$job\"}[5m]) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "系统进程利用率",
          "range": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "rate(node_cpu_seconds_total{mode=\"iowait\",instance=~\"$instance\",job=~\"$job\"}[5m]) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "IO等待",
          "range": true
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "sum(rate(node_cpu_seconds_total{mode=~\"irq|softirq\",instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "中断",
          "range": true
        },
        {
          "refId": "G",
          "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
          "expr": "rate(node_cpu_seconds_total{mode=\"steal\",instance=~\"$instance\",job=~\"$job\"}[5m]) * 100 / on(instance, job) sum(rate(node_cpu_seconds_total{instance=~\"$instance\",job=~\"$job\"}[5m])) by (instance, job)",
          "legendFormat": "虚拟机利用率",
          "range": true
        }
      ]
    },
    {
