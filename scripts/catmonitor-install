#!/usr/bin/env bash
# Unified CATMonitor container deployment entrypoint.
#
# This command composes reviewed deployment layers and validates already-built
# images and already-installed stress assets. It never builds benchmark assets,
# creates an NPU Burn container, edits YAML, or starts a stress workload.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

PROFILE=
ACTION=up
CONFIG_PATH=${CATMONITOR_CONFIG:-/etc/catmonitor/catmonitor.yaml}
STRESS_ROOT=${CATMONITOR_STRESS_ROOT:-/opt/catmonitor/stress}
STATE_DIR=${CATMONITOR_STRESS_STATE_DIR:-/var/lib/catmonitor/stress}
CONTROL_IMAGE=${CATMONITOR_IMAGE:-}
CPU_RUNNER_IMAGE=${CATMONITOR_CPU_STRESS_IMAGE:-}
DOCKER_SOCKET=${CATMONITOR_DOCKER_SOCKET:-/var/run/docker.sock}
DOCKER_BIN=${CATMONITOR_DOCKER_BIN:-docker}
COMPOSE_DIR=${CATMONITOR_COMPOSE_DIR:-}
PROJECT_NAME=${CATMONITOR_COMPOSE_PROJECT:-catmonitor}
WEB_ADDR=${CATMONITOR_WEB_ADDR:-127.0.0.1:19322}
RUNNER_WAIT_SECONDS=60
ACK_ROOT_DOCKER_SOCKET=false
SKIP_DOCTOR=false

usage() {
    cat <<'EOF'
Usage:
  catmonitor-install --profile PROFILE [OPTIONS]

Profiles:
  monitoring   CATMonitor daemon, read-only Web and DFeE
  cpu-stress   monitoring plus the isolated CPU stress runner
  ascend-a2    Ascend monitoring, CPU runner and A2 NPU Burn integration
  ascend-a3    Ascend monitoring, CPU runner and A3 NPU Burn integration

Actions (default: up):
  --action plan      Validate and print the resolved deployment; change nothing
  --action up        Start/update services, wait for the runner, then run doctor
  --action status    Show Compose service state
  --action doctor    Run the read-only stress deployment doctor
  --action down      Stop services without deleting persistent volumes

Options:
  --config PATH              Main CATMonitor YAML
                             (default: /etc/catmonitor/catmonitor.yaml)
  --stress-root PATH         Installed stress plugin root
                             (default: /opt/catmonitor/stress)
  --state-dir PATH           Shared stress state directory
                             (default: /var/lib/catmonitor/stress)
  --control-image IMAGE      Control image; defaults to catmonitor-generic for
                             monitoring/CPU and catmonitor-npu for Ascend
  --cpu-runner-image IMAGE   Reviewed CPU runner image. When omitted, read it
                             from stress-deployment-manifest.json
  --docker-socket PATH       Docker socket for transitional NPU docker_exec
                             (default: /var/run/docker.sock)
  --acknowledge-root-docker-socket
                             Required by Ascend 'up'; acknowledges that the
                             current NPU overlay grants root-equivalent access
  --compose-dir PATH         Directory containing reviewed Compose definitions
  --docker-bin PATH          Docker CLI (default: docker)
  --project-name NAME        Compose project name (default: catmonitor)
  --web-addr ADDRESS         Loopback Web listener (default: 127.0.0.1:19322)
  --runner-wait SECONDS      CPU runner health wait, 1..600 (default: 60)
  --skip-doctor              Do not run post-start doctor
  -h, --help                 Show this help

The installer does not build images or benchmarks, create the fixed NPU Burn
container, modify YAML, or run STREAM/HPL/HPCG/NPU Burn. Prepare those assets
with scripts/stress first. Ascend profiles currently use the explicitly
acknowledged Docker-socket compatibility boundary; this is not enabled for
monitoring or CPU-only profiles.
EOF
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
require_value() { [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 requires a value"; }

while [ "$#" -gt 0 ]; do
    case "$1" in
        --profile) require_value "$@"; PROFILE=$2; shift 2 ;;
        --action) require_value "$@"; ACTION=$2; shift 2 ;;
        --config) require_value "$@"; CONFIG_PATH=$2; shift 2 ;;
        --stress-root) require_value "$@"; STRESS_ROOT=$2; shift 2 ;;
        --state-dir) require_value "$@"; STATE_DIR=$2; shift 2 ;;
        --control-image) require_value "$@"; CONTROL_IMAGE=$2; shift 2 ;;
        --cpu-runner-image) require_value "$@"; CPU_RUNNER_IMAGE=$2; shift 2 ;;
        --docker-socket) require_value "$@"; DOCKER_SOCKET=$2; shift 2 ;;
        --compose-dir) require_value "$@"; COMPOSE_DIR=$2; shift 2 ;;
        --docker-bin) require_value "$@"; DOCKER_BIN=$2; shift 2 ;;
        --project-name) require_value "$@"; PROJECT_NAME=$2; shift 2 ;;
        --web-addr) require_value "$@"; WEB_ADDR=$2; shift 2 ;;
        --runner-wait) require_value "$@"; RUNNER_WAIT_SECONDS=$2; shift 2 ;;
        --acknowledge-root-docker-socket) ACK_ROOT_DOCKER_SOCKET=true; shift ;;
        --skip-doctor) SKIP_DOCTOR=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[ -n "$PROFILE" ] || die "--profile is required"
case "$PROFILE" in
    monitoring|cpu-stress|ascend-a2|ascend-a3) ;;
    *) die "unsupported profile: $PROFILE" ;;
esac
case "$ACTION" in plan|up|status|doctor|down) ;; *) die "unsupported action: $ACTION" ;; esac
case "$PROJECT_NAME" in
    ''|*[!A-Za-z0-9_.-]*) die "--project-name contains unsupported characters" ;;
esac
case "$RUNNER_WAIT_SECONDS" in
    ''|*[!0-9]*) die "--runner-wait must be an integer between 1 and 600" ;;
esac
[ "$RUNNER_WAIT_SECONDS" -ge 1 ] && [ "$RUNNER_WAIT_SECONDS" -le 600 ] || \
    die "--runner-wait must be an integer between 1 and 600"
case "$WEB_ADDR" in
    127.0.0.1:*) web_port=${WEB_ADDR#127.0.0.1:} ;;
    *) die "--web-addr must use the IPv4 loopback address 127.0.0.1" ;;
esac
case "$web_port" in ''|*[!0-9]*|0) die "--web-addr has an invalid port" ;; esac
[ "$web_port" -le 65535 ] || die "--web-addr has an invalid port"

absolute_path() {
    local option=$1 value=$2
    case "$value" in /*) ;; *) die "$option must be absolute: $value" ;; esac
    case "$value" in *$'\n'*|*$'\r'*) die "$option cannot contain a newline" ;; esac
    readlink -m -- "$value"
}

CONFIG_PATH=$(absolute_path --config "$CONFIG_PATH")
STRESS_ROOT=$(absolute_path --stress-root "$STRESS_ROOT")
STATE_DIR=$(absolute_path --state-dir "$STATE_DIR")
DOCKER_SOCKET=$(absolute_path --docker-socket "$DOCKER_SOCKET")

TEST_HOST_ROOT=${CATMONITOR_INSTALL_HOST_ROOT:-}
if [ -n "$TEST_HOST_ROOT" ]; then
    [ "${CATMONITOR_INSTALL_TESTING:-}" = true ] || \
        die "CATMONITOR_INSTALL_HOST_ROOT is reserved for repository tests"
    TEST_HOST_ROOT=$(absolute_path CATMONITOR_INSTALL_HOST_ROOT "$TEST_HOST_ROOT")
elif [ -n "${CATMONITOR_INSTALL_TESTING:-}" ]; then
    die "CATMONITOR_INSTALL_TESTING is reserved for repository tests with an isolated host root"
fi

if [ -z "$COMPOSE_DIR" ]; then
    if [ -f "$SCRIPT_DIR/../docker/docker-compose.yml" ]; then
        COMPOSE_DIR=$(cd -- "$SCRIPT_DIR/../docker" && pwd -P)
    elif [ -f "$SCRIPT_DIR/../lib/catmonitor/docker/docker-compose.yml" ]; then
        COMPOSE_DIR=$(cd -- "$SCRIPT_DIR/../lib/catmonitor/docker" && pwd -P)
    elif [ -f /usr/local/lib/catmonitor/docker/docker-compose.yml ]; then
        COMPOSE_DIR=/usr/local/lib/catmonitor/docker
    else
        die "cannot find Compose definitions; use --compose-dir"
    fi
else
    COMPOSE_DIR=$(absolute_path --compose-dir "$COMPOSE_DIR")
fi

BASE_COMPOSE="$COMPOSE_DIR/docker-compose.yml"
CONFIG_COMPOSE="$COMPOSE_DIR/docker-compose.config.yml"
NPU_COMPOSE="$COMPOSE_DIR/docker-compose.npu.yml"
STRESS_COMPOSE="$COMPOSE_DIR/docker-compose.stress.yml"
NPU_BURN_COMPOSE="$COMPOSE_DIR/docker-compose.stress-npuburn.yml"

for file in "$BASE_COMPOSE" "$CONFIG_COMPOSE"; do
    [ -f "$file" ] && [ ! -L "$file" ] || die "reviewed Compose file is unavailable: $file"
done

is_stress=false
is_ascend=false
expected_generation=
case "$PROFILE" in
    monitoring)
        : "${CONTROL_IMAGE:=catmonitor-generic}"
        ;;
    cpu-stress)
        is_stress=true
        : "${CONTROL_IMAGE:=catmonitor-generic}"
        ;;
    ascend-a2)
        is_stress=true
        is_ascend=true
        expected_generation=A2
        : "${CONTROL_IMAGE:=catmonitor-npu}"
        ;;
    ascend-a3)
        is_stress=true
        is_ascend=true
        expected_generation=A3
        : "${CONTROL_IMAGE:=catmonitor-npu}"
        ;;
esac

validate_image_name() {
    local option=$1 value=$2
    case "$value" in
        ''|*[!A-Za-z0-9._/@:-]*) die "$option contains unsupported characters: $value" ;;
    esac
}
validate_image_name --control-image "$CONTROL_IMAGE"

compose_files=("$BASE_COMPOSE" "$CONFIG_COMPOSE")
services=(catmonitor web dfee)
if [ "$is_stress" = true ]; then
    [ -f "$STRESS_COMPOSE" ] && [ ! -L "$STRESS_COMPOSE" ] || \
        die "reviewed Compose file is unavailable: $STRESS_COMPOSE"
    compose_files+=("$STRESS_COMPOSE")
    services=(cpu-stress-runner catmonitor web dfee)
fi
if [ "$is_ascend" = true ]; then
    for file in "$NPU_COMPOSE" "$NPU_BURN_COMPOSE"; do
        [ -f "$file" ] && [ ! -L "$file" ] || die "reviewed Compose file is unavailable: $file"
    done
    compose_files=("$BASE_COMPOSE" "$CONFIG_COMPOSE" "$NPU_COMPOSE" "$STRESS_COMPOSE" "$NPU_BURN_COMPOSE")
fi

requires_runtime_assets=true
case "$ACTION" in status|down) requires_runtime_assets=false ;; esac

if [ "$requires_runtime_assets" = true ]; then
    [ -f "$CONFIG_PATH" ] && [ ! -L "$CONFIG_PATH" ] || \
        die "CATMonitor config is not a regular file: $CONFIG_PATH"
fi

manifest_value() {
    local file=$1 key=$2
    tr -d '\r\n' <"$file" | sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

DEPLOYMENT_MANIFEST="$STRESS_ROOT/manifests/stress-deployment-manifest.json"
NPU_CONTAINER=
NPU_IMAGE=
if [ "$is_stress" = true ] && [ "$requires_runtime_assets" = true ]; then
    for file in "$STRESS_ROOT/benchmark_check.sh" "$STRESS_ROOT/cpu-runner-benchmark_check.sh"; do
        [ -f "$file" ] && [ ! -L "$file" ] || die "installed stress adapter is unavailable: $file"
        bash -n "$file" || die "installed stress adapter has invalid shell syntax: $file"
    done
    [ -f "$DEPLOYMENT_MANIFEST" ] && [ ! -L "$DEPLOYMENT_MANIFEST" ] || \
        die "stress deployment manifest is unavailable: $DEPLOYMENT_MANIFEST"

    cpu_backend=$(manifest_value "$DEPLOYMENT_MANIFEST" cpu_backend)
    [ "$cpu_backend" = unix ] || \
        die "profile $PROFILE requires deployment manifest cpu_backend=unix (found: ${cpu_backend:-missing})"
    manifest_cpu_image=$(manifest_value "$DEPLOYMENT_MANIFEST" cpu_runner_image)
    validate_image_name "manifest cpu_runner_image" "$manifest_cpu_image"
    if [ -z "$CPU_RUNNER_IMAGE" ]; then
        CPU_RUNNER_IMAGE=$manifest_cpu_image
    elif [ "$CPU_RUNNER_IMAGE" != "$manifest_cpu_image" ]; then
        die "--cpu-runner-image must match the reviewed deployment manifest: $manifest_cpu_image"
    fi
    validate_image_name --cpu-runner-image "$CPU_RUNNER_IMAGE"
fi
if [ "$is_stress" = true ] && [ -z "$CPU_RUNNER_IMAGE" ]; then
    CPU_RUNNER_IMAGE=catmonitor/stress-cpu:unresolved
fi

if [ "$is_ascend" = true ] && [ "$requires_runtime_assets" = true ]; then
    manifest_generation=$(manifest_value "$DEPLOYMENT_MANIFEST" npu_chip_generation)
    [ "$manifest_generation" = "$expected_generation" ] || \
        die "profile $PROFILE requires manifest npu_chip_generation=$expected_generation (found: ${manifest_generation:-missing})"
    NPU_CONTAINER=$(manifest_value "$DEPLOYMENT_MANIFEST" npu_container)
    NPU_IMAGE=$(manifest_value "$DEPLOYMENT_MANIFEST" npu_image)
    case "$NPU_CONTAINER" in
        ''|*[!A-Za-z0-9_.-]*) die "deployment manifest has an invalid npu_container" ;;
    esac
    validate_image_name "manifest npu_image" "$NPU_IMAGE"
fi

if [[ "$DOCKER_BIN" == */* ]]; then
    DOCKER_BIN=$(absolute_path --docker-bin "$DOCKER_BIN")
    [ -x "$DOCKER_BIN" ] || die "Docker CLI is not executable: $DOCKER_BIN"
else
    resolved_docker=$(command -v -- "$DOCKER_BIN" 2>/dev/null || true)
    [ -n "$resolved_docker" ] || die "Docker CLI is unavailable: $DOCKER_BIN"
    DOCKER_BIN=$resolved_docker
fi

DOCKER_HOST_OVERRIDE=
if [ "$is_ascend" = true ]; then
    DOCKER_HOST_OVERRIDE="unix://$DOCKER_SOCKET"
fi

docker_cli() {
    if [ -n "$DOCKER_HOST_OVERRIDE" ]; then
        env "DOCKER_HOST=$DOCKER_HOST_OVERRIDE" "$DOCKER_BIN" "$@"
    else
        "$DOCKER_BIN" "$@"
    fi
}

if docker_cli compose version >/dev/null 2>&1; then
    compose_command=("$DOCKER_BIN" compose)
elif command -v docker-compose >/dev/null 2>&1; then
    compose_command=("$(command -v docker-compose)")
else
    die "Docker Compose v2 plugin or docker-compose is required"
fi

compose_args=(--project-name "$PROJECT_NAME")
for file in "${compose_files[@]}"; do compose_args+=(-f "$file"); done

compose() {
    local environment=(
        "CATMONITOR_CONFIG=$CONFIG_PATH"
        "CATMONITOR_STRESS_ROOT=$STRESS_ROOT"
        "CATMONITOR_STRESS_STATE_DIR=$STATE_DIR"
        "CATMONITOR_IMAGE=$CONTROL_IMAGE"
        "CATMONITOR_CPU_STRESS_IMAGE=${CPU_RUNNER_IMAGE:-unused}"
        "CATMONITOR_DOCKER_SOCKET=$DOCKER_SOCKET"
        "CATMONITOR_WEB_ADDR=$WEB_ADDR"
    )
    if [ -n "$DOCKER_HOST_OVERRIDE" ]; then environment+=("DOCKER_HOST=$DOCKER_HOST_OVERRIDE"); fi
    env "${environment[@]}" "${compose_command[@]}" "${compose_args[@]}" "$@"
}

host_path() {
    local path=$1
    if [ -n "$TEST_HOST_ROOT" ]; then
        printf '%s%s\n' "${TEST_HOST_ROOT%/}" "$path"
    else
        printf '%s\n' "$path"
    fi
}

preflight() {
    docker_cli info >/dev/null 2>&1 || die "cannot access the Docker daemon with $DOCKER_BIN"
    if [ "$requires_runtime_assets" = true ]; then
        docker_cli image inspect "$CONTROL_IMAGE" >/dev/null 2>&1 || \
            die "control image is unavailable locally: $CONTROL_IMAGE"
    fi

    if [ "$is_stress" = true ] && [ "$requires_runtime_assets" = true ]; then
        docker_cli image inspect "$CPU_RUNNER_IMAGE" >/dev/null 2>&1 || \
            die "CPU runner image is unavailable locally: $CPU_RUNNER_IMAGE"
        if [ "$ACTION" = up ]; then
            [ ! -L "$STATE_DIR" ] || die "stress state directory cannot be a symbolic link: $STATE_DIR"
            install -d -m 0750 "$STATE_DIR" "$STATE_DIR/work" "$STATE_DIR/work/hpl" "$STATE_DIR/work/hpcg"
        elif [ "$ACTION" != plan ]; then
            [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] || \
                die "stress state directory is unavailable: $STATE_DIR"
        elif [ -e "$STATE_DIR" ] && { [ ! -d "$STATE_DIR" ] || [ -L "$STATE_DIR" ]; }; then
            die "stress state path is not a regular directory: $STATE_DIR"
        fi
    fi

    if [ "$is_ascend" = true ] && [ "$requires_runtime_assets" = true ]; then
        for required in \
            /usr/local/Ascend/driver \
            /usr/local/Ascend/nnae \
            /usr/local/Ascend/ascend-toolkit \
            /usr/bin/hccn_tool \
            /usr/local/sbin/npu-smi; do
            [ -e "$(host_path "$required")" ] || die "required Ascend host path is unavailable: $required"
        done
        socket_probe=$(host_path "$DOCKER_SOCKET")
        if [ -n "$TEST_HOST_ROOT" ]; then
            [ -e "$socket_probe" ] || die "Docker socket is unavailable: $DOCKER_SOCKET"
        else
            [ -S "$socket_probe" ] || die "Docker socket is unavailable or is not a Unix socket: $DOCKER_SOCKET"
        fi
        container_probe=$(docker_cli container inspect \
            --format '{{.State.Running}}|{{index .Config.Labels "io.catmonitor.npu-burn.fixed-container"}}|{{.Config.Image}}' \
            "$NPU_CONTAINER" 2>/dev/null) || \
            die "fixed NPU Burn container is unavailable: $NPU_CONTAINER"
        IFS='|' read -r npu_running npu_fixed npu_actual_image <<<"$container_probe"
        [ "$npu_running" = true ] || die "fixed NPU Burn container is not running: $NPU_CONTAINER"
        [ "$npu_fixed" = true ] || die "container is not labeled as a CATMonitor fixed NPU Burn container: $NPU_CONTAINER"
        [ "$npu_actual_image" = "$NPU_IMAGE" ] || \
            die "fixed NPU Burn container image differs from deployment manifest: $npu_actual_image"
    fi

    compose config >/dev/null || die "resolved Compose model is invalid"
}

print_plan() {
    printf 'CATMonitor installation plan\n'
    printf '  profile: %s\n' "$PROFILE"
    printf '  action: %s\n' "$ACTION"
    printf '  project: %s\n' "$PROJECT_NAME"
    printf '  control image: %s\n' "$CONTROL_IMAGE"
    printf '  config: %s -> /etc/catmonitor/catmonitor.yaml (read-only)\n' "$CONFIG_PATH"
    printf '  Web listener: %s (loopback)\n' "$WEB_ADDR"
    if [ "$is_stress" = true ]; then
        printf '  CPU runner image: %s\n' "$CPU_RUNNER_IMAGE"
        printf '  stress plugin: %s (read-only)\n' "$STRESS_ROOT"
        printf '  stress state: %s (read-write)\n' "$STATE_DIR"
    fi
    if [ "$is_ascend" = true ]; then
        printf '  NPU generation: %s\n' "$expected_generation"
        printf '  fixed NPU container: %s (%s)\n' "${NPU_CONTAINER:-not required for $ACTION}" "${NPU_IMAGE:-not required for $ACTION}"
        printf '  Docker socket: %s (root-equivalent compatibility boundary)\n' "$DOCKER_SOCKET"
    else
        printf '  Docker socket: not mounted\n'
    fi
    printf '  Compose layers:\n'
    for file in "${compose_files[@]}"; do printf '    - %s\n' "$file"; done
    printf '  services:'
    printf ' %s' "${services[@]}"
    printf '\n'
    printf '  workload execution: none\n'
    if [ "$is_ascend" = true ] && [ "$ACK_ROOT_DOCKER_SOCKET" != true ]; then
        printf '  note: Ascend up requires --acknowledge-root-docker-socket\n'
    fi
}

wait_for_cpu_runner() {
    local container_id health waited=0
    container_id=$(compose ps -q cpu-stress-runner)
    [ -n "$container_id" ] || die "CPU runner container was not created"
    while [ "$waited" -lt "$RUNNER_WAIT_SECONDS" ]; do
        health=$(docker_cli inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
            "$container_id" 2>/dev/null || true)
        case "$health" in
            healthy) return 0 ;;
            unhealthy|exited|dead) die "CPU runner became $health" ;;
        esac
        sleep 1
        waited=$((waited + 1))
    done
    die "CPU runner did not become healthy within ${RUNNER_WAIT_SECONDS}s"
}

run_doctor() {
    [ "$is_stress" = true ] || die "doctor is available only for stress profiles"
    compose exec -T catmonitor catmonitor stress doctor \
        -c /etc/catmonitor/catmonitor.yaml -o table
}

if [ "$ACTION" = up ] && [ "$is_ascend" = true ] && [ "$ACK_ROOT_DOCKER_SOCKET" != true ]; then
    die "Ascend up requires --acknowledge-root-docker-socket; current NPU docker_exec exposes a root-equivalent socket to control containers"
fi

preflight
print_plan

case "$ACTION" in
    plan)
        ;;
    status)
        compose ps
        ;;
    down)
        compose down
        ;;
    doctor)
        run_doctor
        ;;
    up)
        compose up -d "${services[@]}"
        if [ "$is_stress" = true ]; then
            wait_for_cpu_runner
            if [ "$SKIP_DOCTOR" != true ]; then run_doctor; fi
        fi
        printf 'CATMonitor profile is up: %s\n' "$PROFILE"
        printf 'Web: http://%s/\n' "$WEB_ADDR"
        if [ "$is_stress" = true ]; then printf 'Stress: http://%s/stress/\n' "$WEB_ADDR"; fi
        ;;
esac
