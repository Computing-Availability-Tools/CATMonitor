+def frozen_config(generation=None):
+    selected = os.environ.get('CATMONITOR_NPU_FROZEN_CONFIG_FILE')
+    if not selected:
+        return None
+    path = Path(selected)
+    if not path.is_absolute() or path.stat().st_size > 48 * 1024:
+        raise ValueError('invalid frozen NPU configuration')
+    proof = json.loads(path.read_text())
+    if proof['generation'] not in ('A2', 'A3', 'A5') or (generation and proof['generation'] != generation):
+        raise ValueError('frozen NPU generation mismatch')
+    return copy.deepcopy(proof['config'])
+
+
 def load_config(generation, directory=None):
+    frozen = frozen_config(generation)
+    if frozen is not None:
+        return frozen
     directory = Path(directory or Path(__file__).parent / 'config')
