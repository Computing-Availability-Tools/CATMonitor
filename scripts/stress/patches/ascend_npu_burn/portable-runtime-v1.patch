+"""CATMonitor portable-runtime-v1: no hardware discovery at import time."""
+import glob
+import ctypes
+import os
+from pathlib import Path
+import queue
+import re
+import signal
+import stat
+import subprocess
+import time
+
+
+def cpu_list(value):
+    result = set()
+    for token in value.strip().split(','):
+        if not token:
+            continue
+        if not re.fullmatch(r'\d+(?:-\d+)?', token):
+            raise ValueError('Invalid CPU list: ' + value)
+        limits = list(map(int, token.split('-')))
+        low, high = limits[0], limits[-1]
+        if high < low or high > 1048576:
+            raise ValueError('Invalid CPU range')
+        result.update(range(low, high + 1))
+    return result
+
+
+def effective_cpuset(cgroup_root=Path('/sys/fs/cgroup'), membership=Path('/proc/self/cgroup')):
+    # Both cgroup-namespace root and non-namespaced process-relative v1/v2.
+    candidates = [cgroup_root / 'cpuset.cpus.effective',
+                  cgroup_root / 'cpuset/cpuset.effective_cpus']
+    for line in membership.read_text().splitlines():
+        _, controllers, relative = line.split(':', 2)
+        if not controllers:
+            candidates.append(cgroup_root / relative.lstrip('/') / 'cpuset.cpus.effective')
+        elif 'cpuset' in controllers.split(','):
+            candidates.append(cgroup_root / 'cpuset' / relative.lstrip('/') / 'cpuset.effective_cpus')
+    allowed = None
+    for path in candidates:
+        if path.is_file() and path.read_text().strip():
+            current = cpu_list(path.read_text())
+            allowed = current if allowed is None else allowed & current
+    return allowed
+
+
+def numa_cpus(sys_root=Path('/sys'), allowed=None):
+    """Hardware online CPUs intersect container cpuset; not worker affinity.
+
+    Socket count is neither read nor guessed. Missing NUMA metadata fails closed.
+    Individual nodes may be empty under a container cpuset.
+    """
+    online = cpu_list((sys_root / 'devices/system/cpu/online').read_text())
+    if allowed is None:
+        allowed = effective_cpuset()
+    if allowed is not None:
+        online &= set(allowed)
+    nodes = {}
+    for path in (sys_root / 'devices/system/node').glob('node[0-9]*/cpulist'):
+        node = int(path.parent.name[4:])
+        nodes[node] = sorted(cpu_list(path.read_text()) & online)
+    if not nodes or not any(nodes.values()):
+        raise RuntimeError('No online CPU NUMA topology within container cpuset')
+    return nodes
+
+
+def binding_cpus(nodes, node, affinity):
+    cpus = sorted(set(nodes.get(node, [])) & set(affinity))
+    if not cpus:
+        raise RuntimeError('Selected NUMA node has no allowed online CPUs: ' + str(node))
+    return cpus
+
+
+def select_topology(pci, node_to_pci, runtime_count, mode, selected, expected_count, runtime_pci=None):
+    """Pure admission: PCI inventory != container nodes != runtime indices."""
+    if runtime_count != expected_count or runtime_count <= 0:
+        raise RuntimeError('Runtime count differs from declared mapped device count')
+    if len(node_to_pci) != runtime_count:
+        raise RuntimeError('Container device node count differs from runtime count')
+    if mode == 'single':
+        if runtime_count != 1 or selected != '0':
+            raise RuntimeError('Single-device mode requires exactly one device and explicit logical 0')
+        bdf = next(iter(node_to_pci.values()))
+        if bdf is None or bdf not in pci or pci[bdf] < 0:
+            raise RuntimeError('Single-device PCI/NUMA mapping cannot be verified')
+        if runtime_pci != {0: bdf}:
+            raise RuntimeError('Runtime logical 0 PCI identity is missing or differs from the mapped character device')
+        return {pci[bdf]: [0]}
+    if mode != 'full' or len(pci) != runtime_count:
+        raise RuntimeError('Full mode requires full PCI/runtime/node counts; use explicit single mode for a subset')
+    result = {}
+    for logical, bdf in enumerate(sorted(pci)):
+        if pci[bdf] < 0:
+            raise RuntimeError('Unknown NPU NUMA node: ' + bdf)
+        result.setdefault(pci[bdf], []).append(logical)
+    valid = set(range(runtime_count))
+    if selected != 'all':
+        ids = selected.split(',')
+        if len(set(ids)) != len(ids) or any(not x.isdecimal() or int(x) not in valid for x in ids):
+            raise RuntimeError('Invalid NPU logical device selection')
+    return result
+
+
+def runtime_pci_bdf(index, library=None):
+    # Public CANN API contract: aclrtDeviceGetPCIBusId(int32_t, char*, int32_t).
+    # No set_device, workload, host-number arithmetic or guessed fallback.
+    try:
+        library = library if library is not None else ctypes.CDLL('libascendcl.so')
+        query = library.aclrtDeviceGetPCIBusId
+    except (OSError, AttributeError) as error:
+        raise RuntimeError('CANN runtime PCI identity API unavailable; single-device mapping is UNVERIFIED') from error
+    query.argtypes = [ctypes.c_int32, ctypes.POINTER(ctypes.c_char), ctypes.c_int32]
+    query.restype = ctypes.c_int32
+    buffer = ctypes.create_string_buffer(64)
+    status = query(index, buffer, len(buffer))
+    if status != 0:
+        raise RuntimeError('CANN runtime PCI identity query failed; single-device mapping is UNVERIFIED')
+    bdf = buffer.value.decode('ascii').lower()
+    if not re.fullmatch(r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]', bdf):
+        raise RuntimeError('Invalid runtime PCI identity')
+    return bdf
+
+
+def runtime_topology():
+    import torch_npu
+    output = subprocess.check_output(['lspci', '-D', '-d', '19e5:'], text=True, timeout=10)
+    pci = {}
+    for line in output.splitlines():
+        if 'Processing accelerators' not in line:
+            continue
+        bdf = line.split()[0].lower()
+        if not re.fullmatch(r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]', bdf):
+            raise RuntimeError('Invalid PCI address')
+        pci[bdf] = int(Path('/sys/bus/pci/devices', bdf, 'numa_node').read_text().strip())
+    nodes = {}
+    for name in glob.glob('/dev/davinci[0-9]*'):
+        if not re.fullmatch(r'/dev/davinci\d+', name):
+            continue
+        info = os.stat(name)
+        if not stat.S_ISCHR(info.st_mode):
+            raise RuntimeError('Expected character device: ' + name)
+        link = Path('/sys/dev/char', f'{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}', 'device')
+        resolved = link.resolve(strict=True) if link.exists() else None
+        matches = [p.name.lower() for p in (resolved, *resolved.parents) if p.name.lower() in pci] if resolved else []
+        nodes[name[12:]] = matches[0] if matches else None
+    count = torch_npu.npu.device_count()
+    mode = os.getenv('CATMONITOR_NPU_DEVICE_MODE', 'full')
+    runtime_pci = {0: runtime_pci_bdf(0)} if mode == 'single' and count == 1 else None
+    topology = select_topology(pci, nodes, count, mode,
+                               os.getenv('NPU_BURN_DEVICE', ''), int(os.getenv('CATMONITOR_NPU_DEVICE_COUNT', '0')), runtime_pci)
+    return {'runtime_count': count, 'node_ids': sorted(nodes, key=int), 'pci_addresses': sorted(pci),
+            'node_pci': nodes, 'runtime_pci': runtime_pci,
+            'numa_to_logical': topology, 'mapping_source': 'runtime_kernel_pci' if mode == 'single' else 'full_pci_order'}
+
+
+def receive(q, processes, deadline):
+    while True:
+        failed = [p for p in processes if p.exitcode not in (None, 0)]
+        if failed:
+            raise RuntimeError('Worker exited before result: ' + ','.join(str(p.exitcode) for p in failed))
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError('Worker readiness/result deadline exceeded')
+        try:
+            return q.get(timeout=min(0.2, remaining))
+        except queue.Empty:
+            if processes and all(p.exitcode is not None for p in processes):
+                raise RuntimeError('Workers exited without expected result')
+
+
+def join_success(processes, deadline):
+    """Allow vendor runtime finalizers to finish within the job's own budget."""
+    for p in processes:
+        while p.is_alive():
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError('Worker exit deadline exceeded')
+            p.join(timeout=min(0.2, remaining))
+        p.join(timeout=0)
+        if p.exitcode != 0:
+            raise RuntimeError(f'Worker {p.pid} exited with code {p.exitcode}')
+
+
+def job_timeout():
+    # Controller/workload executor owns this budget. It is not the per-stream
+    # synchronization timeout passed to upstream --timeout.
+    seconds = int(os.getenv('CATMONITOR_NPU_JOB_TIMEOUT_SECONDS', '3600'))
+    if not 1 <= seconds <= 86400:
+        raise ValueError('Invalid NPU job timeout')
+    return seconds
+
+
+def reap(processes):
+    processes = [p for p in processes if p.pid is not None]
+    for p in processes:
+        if p.is_alive():
+            p.terminate()
+    deadline = time.monotonic() + 3
+    for p in processes:
+        p.join(max(0, deadline - time.monotonic()))
+    for p in processes:
+        if p.is_alive():
+            p.kill()
+        p.join(timeout=3)
+        if p.is_alive():
+            raise RuntimeError('Worker did not exit after SIGKILL')
+
+
+def terminated(signum, frame):
+    raise SystemExit(128 + signum)
+
+
+def install_termination_handlers():
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        signal.signal(sig, terminated)
