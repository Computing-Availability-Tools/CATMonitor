+"""Hardware-free case inventory; availability here is not hardware certification."""
+import copy
+import json
+from pathlib import Path
+
+
+def merge_config(base, override):
+    result = copy.deepcopy(base)
+    cases = {name: data for entry in result.get('cases', []) for name, data in entry.items()}
+    cases.update({name: copy.deepcopy(data) for entry in override.get('cases', [])
+                  for name, data in entry.items()})
+    groups = dict(result.get('group', {}))
+    groups.update(override.get('group', {}))
+    result.update(copy.deepcopy(override))
+    result['cases'], result['group'] = [cases], groups
+    return result
+
+
+def load_config(generation, directory=None):
+    directory = Path(directory or Path(__file__).parent / 'config')
+    data = json.loads((directory / 'base_config.json').read_text())
+    if generation not in ('A2', 'A3', 'A5'):
+        raise ValueError('Unknown chip generation')
+    if generation in ('A2', 'A3'):
+        data = merge_config(data, json.loads((directory / (generation.lower() + '_config.json')).read_text()))
+    return data
+
+
+def catalog(generation, directory=None, supported_dtypes=None):
+    data = load_config(generation, directory)
+    result = []
+    for entry in data['cases']:
+        for name, case in entry.items():
+            reason = ''
+            if name in ('gpt3', 'llama2'):
+                reason = 'model requires a separately prepared SDC reference; not an operator selection'
+            elif generation == 'A2' and name == 'quant_matmul':
+                reason = 'no upstream A2 QuantMatmul strategy; do not substitute the A3/A5 strategy'
+            dtypes = case.get('dtype', [])
+            if isinstance(dtypes, str):
+                dtypes = [dtypes]
+            if not reason and supported_dtypes is not None:
+                supported = set(supported_dtypes)
+                # Upstream MatmulOp explicitly implements hfloat32 using
+                # float32 tensors plus allow_hf32; it is not a tensor dtype.
+                if name == 'matmul' and 'float32' in supported:
+                    supported.add('hfloat32')
+                missing = sorted(set(dtypes) - supported)
+                if missing:
+                    reason = 'unsupported dtype APIs: ' + ','.join(missing)
+            result.append(dict(name=name, seq=case['seq'], dtypes=dtypes,
+                               selectable=not reason, reason=reason,
+                               hardware_validation='NOT_RUN'))
+    return result
+
+
+def select_cases(generation, run_case, group, directory=None, supported_dtypes=None):
+    if bool(run_case) == bool(group):
+        raise ValueError('configure exactly one run_case or group')
+    items = catalog(generation, directory, supported_dtypes)
+    by_name = {item['name']: item for item in items}
+    by_seq = {str(item['seq']): item['name'] for item in items}
+    if group:
+        sequences = load_config(generation, directory).get('group', {}).get(group)
+        if not sequences or any(str(seq) not in by_seq for seq in sequences):
+            raise ValueError('unknown, empty or incomplete group: ' + group)
+        names = [by_seq[str(seq)] for seq in sequences]
+    else:
+        names = [by_seq.get(value.strip(), value.strip()) for value in run_case.split(',')]
+    if not names or len(set(names)) != len(names):
+        raise ValueError('empty or duplicate NPU cases')
+    for name in names:
+        if name not in by_name:
+            raise ValueError('unknown NPU case: ' + name)
+        if not by_name[name]['selectable']:
+            raise ValueError(name + ': ' + by_name[name]['reason'])
+    return names
